# MTT Menejer Diagnostika — muhit o'zgaruvchilari namunasi
# Bu faylni `.env` nomi bilan nusxalang va qiymatlarni to'ldiring.
# `.env` faylini git'ga qo'shmang (maxfiy qiymatlar).

# --- Umumiy ---
ENVIRONMENT=development
DEBUG=false

# --- Ma'lumotlar bazasi (PostgreSQL) ---
DATABASE_URL=postgresql+psycopg://mtt:mtt@localhost:5432/mtt_diagnostika
POSTGRES_USER=mtt
POSTGRES_PASSWORD=mtt
POSTGRES_DB=mtt_diagnostika

# --- JWT (R2.1, R17.1) ---
JWT_SECRET_KEY=please-generate-a-strong-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Parolni tiklash (R3.1) ---
PASSWORD_RESET_CODE_EXPIRE_MINUTES=15

# --- Login bloklash (R2.7) ---
MAX_FAILED_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- Fayl xotirasi (R11, R18.2) ---
FILE_STORAGE_BACKEND=local
FILE_STORAGE_DIR=./var/uploads
MAX_UPLOAD_SIZE_BYTES=10485760

# --- Rate limiting (R17.3) ---
RATE_LIMIT_PER_MINUTE=60
